# Odysseus production deployment — copy to .env next to docker-compose.yml
# and edit the values below.  Keep the file mode at 600: it holds deployment
# secrets (SearXNG secret, optional provider keys).
#
#   install -m 600 deploy/.env.production.example /opt/odysseus/.env
#   $EDITOR /opt/odysseus/.env
#
# Compose reads this file for ${VAR} substitution. Values in this file do not
# automatically reach the app unless docker-compose.yml also lists them under
# `environment:` — the ones that matter for the app are already listed there.

# ── Network ────────────────────────────────────────────────────────────────
# Bind ONLY to the Tailscale interface so the service is never exposed on the
# LAN. Find the address with:  tailscale ip -4
# Example: APP_BIND=100.101.102.103
APP_BIND=100.x.y.z
APP_PORT=7000

# Allowed browser origins. Include both the Tailscale IP and the MagicDNS
# name you will actually type in the browser (scheme + host + port, no slash).
ALLOWED_ORIGINS=http://100.x.y.z:7000,http://odysseus.tailnet-name.ts.net:7000

# Plain HTTP inside the encrypted tailnet: keep Secure cookies off.
# Set to true only if you put HTTPS (e.g. `tailscale serve`) in front.
SECURE_COOKIES=false

# Externally reachable origin for MCP OAuth callbacks. Usually the same origin
# as ALLOWED_ORIGINS. Leave empty if you do not use remote MCP OAuth.
OAUTH_REDIRECT_BASE_URL=

# ── Identity / permissions ─────────────────────────────────────────────────
# Never disable auth on a shared or remotely reachable host.
AUTH_ENABLED=true
LOCALHOST_BYPASS=false

# Host UID/GID that will own ./data and ./logs. On the target: id -u / id -g
PUID=1000
PGID=1000

# ── Storage paths ──────────────────────────────────────────────────────────
APP_DATA_DIR=./data
APP_LOGS_DIR=./logs

# ── Image build ────────────────────────────────────────────────────────────
# Installs PyMuPDF, markitdown, faster-whisper, ddgs (feature parity).
# If a package has no Python 3.14 wheel, use the selective fallback described
# in deploy/README.md and rebuild.
INSTALL_OPTIONAL=true

# ── Model endpoints ────────────────────────────────────────────────────────
# The DeepSeek endpoint and its API key are stored (encrypted) in ./data/app.db
# and decrypted with ./data/.app_key — no key is needed here for that.
# LLM_HOST only matters for Ollama-compatible services. With cloud APIs only,
# this value is unused; host.docker.internal keeps it harmless.
LLM_HOST=host.docker.internal
# Optional comma-separated extra LLM hosts for the Cookbook.
LLM_HOSTS=

# ── Bundled services ───────────────────────────────────────────────────────
# docker-compose.yml points the app at the internal SearXNG service.
SEARXNG_INSTANCE=http://searxng:8080

# SearXNG signs its instance secret with this value. Leave empty to let the
# container generate one on first boot (stored in the searxng-data volume).
SEARXNG_SECRET=

# Optional ntfy base URL, only needed if you use ntfy reminders directly.
NTFY_BASE_URL=http://localhost:8091

# ── Optional provider credentials ──────────────────────────────────────────
# Most search/provider keys can also be set in the UI (stored in app.db).
# These environment variables are read by docker-compose.yml when present.
# DATA_BRAVE_API_KEY=
# GOOGLE_API_KEY=
# GOOGLE_PSE_CX=
# TAVILY_API_KEY=
# SERPER_API_KEY=
# HF_TOKEN=
